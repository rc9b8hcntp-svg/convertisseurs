{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convertisseurs",
  "version": "1.0.0",
  "identifier": "fr.maxence.convertisseurs",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run vendor",
    "beforeDevCommand": "npm run vendor"
  },
  "app": {
    "windows": [
      {
        "title": "Convertisseurs",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Maxence",
    "shortDescription": "Convertisseurs de fichiers et audio 8D, hors ligne",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "fr-FR" }
    }
  }
}
